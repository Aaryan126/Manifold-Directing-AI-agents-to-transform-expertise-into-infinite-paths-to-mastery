POSTGRES_USER=coursefoundry
POSTGRES_PASSWORD=coursefoundry
POSTGRES_DB=coursefoundry
DATABASE_URL=postgresql://coursefoundry:coursefoundry@postgres:5432/coursefoundry
PIPELINE_BASE_URL=http://pipeline:8000
NEXT_PUBLIC_PIPELINE_BASE_URL=http://localhost:8000
ASR_PROVIDER=openai
VIDEO_PROVIDER=local
LOCAL_VIDEO_STORAGE_PATH=/data/video
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_MAX_STORED_VIDEOS=10
MUX_POLL_INTERVAL_SECONDS=2
MUX_POLL_TIMEOUT_SECONDS=600
OPENAI_API_KEY=

# Agnes powers selected interactive agents only when explicitly enabled.
# Keep the provider values as openai until AGNES_API_KEY has been configured
# and `npm run test:agnes:live` passes.
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_AGENT_MODEL=agnes-2.5-flash
AGNES_FAST_MODEL=agnes-1.5-flash
AGNES_FALLBACK_TO_OPENAI=true
COURSE_DIRECTOR_PROVIDER=openai
DASHBOARD_ASSISTANT_PROVIDER=openai
LEARNING_GUIDE_PROVIDER=openai
